        {"expr": "histogram_quantile(0.95, sum(rate(fluxx_otlp_ingest_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum(rate(fluxx_otlp_ingest_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C"}
