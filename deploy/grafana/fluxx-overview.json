      "title": "Gateway RSS",
      "type": "stat",
      "targets": [
        {"expr": "process_resident_memory_bytes{job=\"fluxx-gateway\"}", "refId": "A"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
