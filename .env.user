# ─────────────────────────────────────────────────────────────────────
# .env.user — RUNTIME environment for the running gateway binary.
#
# This file is PURELY DOCUMENTATION. Cargo does not load it. Operators
# copy values they want into their own deployment env (systemd unit,
# Docker `-e`, Kubernetes Secret, shell `export`, etc.) before
# starting the binary:
#
#     export FLUXX_API_KEY=flx_live_…
#     ./fluxx start
#
# Every var below is OPTIONAL except where marked. The minimum to run
# a real production binary is to set FLUXX_API_KEY.
# ─────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════
# Required for live auth (everything else has a default)
# ═════════════════════════════════════════════════════════════════════

# The operator's PAT. Triple-duty single secret:
#   (1) edge-auth bearer for /v1/*
#   (2) gateway's bearer to the upstream auth server
#   (3) defense-in-depth — dashboard-submitted keys must equal it
#       before the gateway forwards them upstream
#
# Without it, the binary falls back to passthrough mode and warns
# loudly on every verify.
#
# FLUXX_API_KEY=flx_live_…


# ═════════════════════════════════════════════════════════════════════
# Auth / security
# ═════════════════════════════════════════════════════════════════════

# Where the sha256(token) is persisted between boots.
# Default: /var/lib/fluxx/admin.token.sha256
# FLUXX_API_KEY_FILE=/var/lib/fluxx/admin.token.sha256

# If set, the SDK ingest endpoints (/v1/rum, /v1/logs, /v1/events,
# /v1/otlp/*, /v1/prom/write) also require the bearer. Browser RUM has
# no server secret, so ingest is unauthenticated by default.
# FLUXX_REQUIRE_INGEST_AUTH=true

# CSV of allowed origins for browser RUM. Unset → no CORS layer.
# FLUXX_CORS_ORIGIN=https://app.example.com,https://admin.example.com

# Must be `true` to allow FLUXX_CORS_ORIGIN=*
# FLUXX_CORS_ALLOW_ANY=true


# ═════════════════════════════════════════════════════════════════════
# Agent identity / runtime
# ═════════════════════════════════════════════════════════════════════

# Stable agent ID reported to the cloud forwarder. Default: random
# UUID generated at first boot.
# FLUXX_AGENT_ID=fluxx-prod-01

# Cloud-forwarder fallback when FLUXX_AGENT_ID isn't set.
# Default: system uname().
# HOSTNAME=fluxx-prod-01

# Where uploaded sourcemaps live on disk. Default: built-in path.
# FLUXX_SOURCEMAP_DIR=/var/lib/fluxx/sourcemaps

# Used by `fluxx release sourcemaps` and `fluxx errors` CLI subcommands
# to reach a running agent. Default: http://127.0.0.1:7007
# FLUXX_AGENT_URL=http://127.0.0.1:7007

# Server host (default 127.0.0.1) and port (default 7007). Override
# via APP_-prefixed env names with __ as nested separator.
# APP_SERVER__HOST=0.0.0.0
# APP_SERVER__PORT=7007


# ═════════════════════════════════════════════════════════════════════
# Legacy cloud forwarder (api.fluxx.dev) — only set if you're paying
# for hosted Fluxx. Off by default.
# ═════════════════════════════════════════════════════════════════════

# FLUXX_API_URL=https://api.fluxx.dev
# FLUXX_FORWARD_TO_CLOUD=true
# FLUXX_SELF_HOSTED=true
# FLUXX_OFFLINE_MODE=1


# ═════════════════════════════════════════════════════════════════════
# Mesh / clustering — opt-in, all unset by default
# ═════════════════════════════════════════════════════════════════════

# FLUXX_MESH_CONFIG=/etc/fluxx/mesh.toml
# FLUXX_NODE_ID=node-a
# FLUXX_MESH_BIND=0.0.0.0:7008
# FLUXX_MESH_PEERS=node-b:7008,node-c:7008
# FLUXX_MESH_FEDERATION=true
# FLUXX_MESH_QUERY_TIMEOUT=5


# ═════════════════════════════════════════════════════════════════════
# Integration probes — off by default
# ═════════════════════════════════════════════════════════════════════

# FLUXX_INTEGRATIONS_POSTGRES=postgres://u:p@h/db
# FLUXX_INTEGRATIONS_REDIS=127.0.0.1:6379,cache.local:6379
# FLUXX_INTEGRATIONS_DOCKER=true
# FLUXX_INTEGRATIONS_HTTP_PROBES=https://example.com/health
# FLUXX_INTEGRATIONS_INTERVAL_SECS=30


# ═════════════════════════════════════════════════════════════════════
# Alert sinks — off by default
# ═════════════════════════════════════════════════════════════════════

# Generic outbound webhook (HMAC-SHA256 signed)
# FLUXX_WEBHOOK_URL=https://hooks.example.com/fluxx
# FLUXX_WEBHOOK_SECRET=…

# Slack
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
# SLACK_CHANNEL=#alerts
# SLACK_USERNAME=Fluxx
# SLACK_ICON=:warning:

# Email (all three required to enable)
# SMTP_HOST=smtp.example.com
# SMTP_USER=alerts@example.com
# SMTP_PASS=…
# SMTP_PORT=587
# SMTP_USE_TLS=true
# ALERT_EMAIL_FROM=alerts@example.com
# ALERT_EMAIL_TO=oncall@example.com,sre@example.com

# Generic alert webhook
# ALERT_WEBHOOK_URL=https://hooks.example.com/alerts
# ALERT_WEBHOOK_METHOD=POST


# ═════════════════════════════════════════════════════════════════════
# AI-assisted diagnostics — off by default
# ═════════════════════════════════════════════════════════════════════

# OPENAI_API_KEY=sk-…
# ANTHROPIC_API_KEY=sk-ant-…
# AI_MODEL=gpt-4o-mini


# ═════════════════════════════════════════════════════════════════════
# Ticketing integrations — off by default
# ═════════════════════════════════════════════════════════════════════

# Jira (host/user/token all required to enable)
# JIRA_HOST=example.atlassian.net
# JIRA_USER=alerts@example.com
# JIRA_TOKEN=…
# JIRA_PROJECT=OPS
# JIRA_ISSUE_TYPE=Bug
# JIRA_AUTO_CREATE=true

# GitHub (token/owner/repo all required to enable)
# GITHUB_TOKEN=ghp_…
# GITHUB_OWNER=acme
# GITHUB_REPO=infra
# GITHUB_AUTO_CREATE=true
